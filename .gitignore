

# -------------------------------------------------------------------
# Virtual Environments
#
# Keep virtual environments out of source control to avoid bloating the
# repository and to ensure dependencies are managed via requirements.txt.
# -------------------------------------------------------------------
venv/
env/
.venv/
.env/
*/venv/
*/env/
*/.venv/
*/.env/

# -------------------------------------------------------------------
# Python bytecode and cache
#
# These files are generated by the Python interpreter to speed up execution.
# They are not source code and can be regenerated at any time.
# -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# -------------------------------------------------------------------
# Build, distribution, and packaging artifacts
#
# These are generated when you build or distribute your project.
# -------------------------------------------------------------------
build/
dist/
sdist/
*.egg-info/
pip-wheel-metadata/
*.manifest
*.spec

# -------------------------------------------------------------------
# Secrets and configuration
#
# NEVER commit secrets (API keys, passwords, etc.). Instead, commit a
# template file (e.g., .env.example) with placeholder values.
# -------------------------------------------------------------------
.env
.env.*
!.env.example
config.ini
secrets.yaml

# -------------------------------------------------------------------
# Testing artifacts
#
# Caches, reports, and other files generated by testing tools.
# -------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# -------------------------------------------------------------------
# IDE and editor directories
#
# User-specific settings for code editors.
# -------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -------------------------------------------------------------------
# Logs and databases
#
# Runtime artifacts that should not be in version control.
# -------------------------------------------------------------------
*.log
*.db
*.sqlite3

# -------------------------------------------------------------------
# Jupyter Notebook checkpoints
# -------------------------------------------------------------------
.ipynb_checkpoints

# Utility files
hex.txt
asterix.pcap

# Local settings
scr/adsb2asterix/globals_app.py

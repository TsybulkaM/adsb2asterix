[Unit]
Description=ADS-B to ASTERIX Processor
Wants=dump1090-fa.service
After=network.target dump1090-fa.service

[Service]
User=devops
WorkingDirectory=/opt/adsb-asterix-gateway

ExecStart=/opt/adsb-asterix-gateway/venv/bin/python3 /opt/adsb-asterix-gateway/scr/adsb-asterix-gateway/main.py

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target